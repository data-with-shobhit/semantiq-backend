# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=30

# ── Postgres (Supabase) ───────────────────────────────────────────────────────
# Get from: Supabase dashboard → Project Settings → Database → Connection string
# Use the pooler URL (port 6543) for serverless / Cloud Run
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Get from: Upstash console → your Redis → Connection details → rediss:// URL
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379/0
CELERY_BROKER_URL=rediss://default:<password>@<host>.upstash.io:6379/0
CELERY_RESULT_BACKEND=rediss://default:<password>@<host>.upstash.io:6379/0

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
# Get from: Qdrant Cloud console → your cluster → Connection details
QDRANT_HOST=<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=your-qdrant-api-key

# ── Voyage AI (embeddings + reranker) ────────────────────────────────────────
# Get from: dash.voyageai.com → API Keys
VOYAGE_API_KEY=pa-...
VOYAGE_EMBEDDING_MODEL=voyage-4
VOYAGE_RERANKER_MODEL=rerank-2.5

# ── LLM — Groq (default) ─────────────────────────────────────────────────────
# Get from: console.groq.com → API Keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_API_KEY_2=gsk_...                    # second key for RAGAS eval rotation
GROQ_GENERATION_MODEL=llama-3.3-70b-versatile
GROQ_EVAL_MODEL=openai/gpt-oss-120b

# ── LLM — Gemini (HyDE rewriter) ─────────────────────────────────────────────
# Get from: aistudio.google.com → API Keys
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# ── LLM — LM Studio (local alternative) ──────────────────────────────────────
# Uncomment and set LLM_PROVIDER=lmstudio to use local Gemma instead of Groq
# LLM_PROVIDER=lmstudio
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=gemma-4-e4b-it

# ── LLM — Anthropic (optional) ───────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# ── LLM — OpenRouter (optional fallback) ─────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── Retrieval ─────────────────────────────────────────────────────────────────
SCORE_THRESHOLD=0.65
MAX_CHUNKS=5
RRF_K=60
USE_HYDE=true

# ── Storage — Cloudflare R2 ───────────────────────────────────────────────────
# Get from: Cloudflare dashboard → R2 → Manage R2 API tokens
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# Local storage alternative (no credentials needed, dev only)
# STORAGE_BACKEND=local
# STORAGE_ROOT=storage/docs

# ── Web Search (Tavily) ───────────────────────────────────────────────────────
# Get from: app.tavily.com → API Keys
# Used as CRAG fallback when retrieval score < SCORE_THRESHOLD
TAVILY_API_KEY=tvly-...

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Local dev — add this exact URI in Google Cloud Console → Authorized redirect URIs
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Production — set to your Cloud Run URL:
# GOOGLE_REDIRECT_URI=https://semantiq-backend-xxxx-uc.a.run.app/auth/google/callback

# Where to redirect after login (your frontend)
FRONTEND_URL=http://localhost:3000
# Production:
# FRONTEND_URL=https://semantiq-frontend-henna.vercel.app

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console     # console (human-readable) | json (production)

# ── LangSmith ─────────────────────────────────────────────────────────────────
# Get from: smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=rag-platform
