# Cloud Run env vars — copy to .env.yaml and fill values
# DO NOT commit .env.yaml (it has secrets)
# .env.yaml is in .gitignore

JWT_SECRET: "your-jwt-secret"
JWT_ALGORITHM: "HS256"
JWT_EXPIRY_DAYS: "30"

DATABASE_URL: "postgresql://..."
REDIS_URL: "rediss://..."
CELERY_BROKER_URL: "rediss://..."
CELERY_RESULT_BACKEND: "rediss://..."

QDRANT_HOST: "xxx.cloud.qdrant.io"
QDRANT_PORT: "6333"
QDRANT_API_KEY: "your-qdrant-api-key"

VOYAGE_API_KEY: "pa-..."
VOYAGE_EMBEDDING_MODEL: "voyage-4"
VOYAGE_RERANKER_MODEL: "rerank-2.5"

LLM_PROVIDER: "groq"
GROQ_API_KEY: "gsk_..."
GROQ_API_KEY_2: "gsk_..."
GROQ_GENERATION_MODEL: "llama-3.3-70b-versatile"
GROQ_EVAL_MODEL: "openai/gpt-oss-120b"

GEMINI_API_KEY: "AIza..."
GEMINI_MODEL: "gemini-2.0-flash"

TAVILY_API_KEY: "tvly-..."

STORAGE_BACKEND: "r2"
R2_ACCOUNT_ID: "your-account-id"
R2_ACCESS_KEY_ID: "your-access-key"
R2_SECRET_ACCESS_KEY: "your-secret-key"
R2_BUCKET_NAME: "your-bucket"

GOOGLE_CLIENT_ID: "xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET: "GOCSPX-..."
GOOGLE_REDIRECT_URI: "https://YOUR-CLOUD-RUN-API-URL/auth/google/callback"
FRONTEND_URL: "https://semantiq-frontend-henna.vercel.app"

SCORE_THRESHOLD: "0.65"
MAX_CHUNKS: "5"
RRF_K: "60"
USE_HYDE: "true"

LOG_LEVEL: "INFO"
LOG_FORMAT: "json"

LANGCHAIN_TRACING_V2: "true"
LANGCHAIN_ENDPOINT: "https://api.smith.langchain.com"
LANGCHAIN_API_KEY: "lsv2_pt_..."
LANGCHAIN_PROJECT: "rag-platform"
